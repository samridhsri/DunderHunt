# DunderHunt Configuration

# Database (defaults to SQLite for local dev if empty or postgresql://...)
DATABASE_URL=sqlite+aiosqlite:///./dunderhunt.db

# Redis Cache (Optional: falls back to in-memory TTL cache if empty)
REDIS_URL=

# LLM Providers (Configure at least one API key, or set LLM_PROVIDER=mock for offline dev)
LLM_PROVIDER=mock  # Options: mock, gemini, openai, anthropic
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Server Config
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000"]
